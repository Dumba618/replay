{
  "name": "replay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "start:render": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:store": "npx --yes tsx@4.23.15 --conditions react-server scripts/store-smoke.ts",
    "test:minigames": "npx --yes tsx@4.23.15 scripts/minigames-smoke.ts",
    "verify": "npm run typecheck && npm run build && npm run test:store && npm run test:minigames"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.5",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "lucide-react": "0.577.0",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "server-only": "0.0.1",
    "spin-wheel": "5.0.2",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "autoprefixer": "10.4.27",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
